<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vehimap.Mobile.ViewModels"
             x:Class="Vehimap.Mobile.Views.MobileHomeView"
             x:DataType="vm:MobileHomeViewModel"
             AutomationProperties.AutomationId="MobileHomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" Spacing="14">
      <TextBlock Text="{Binding Heading}"
                 FontSize="26"
                 FontWeight="Bold"
                 TextWrapping="Wrap"
                 AutomationProperties.AutomationId="MobileHomeHeading"
                 AutomationProperties.Name="{Binding Heading}"
                 AutomationProperties.HeadingLevel="1" />
      <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Padding="14" BorderThickness="1" CornerRadius="8">
          <TextBlock Text="{Binding VehicleCountText}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="MobileHomeVehicleCount"
                     AutomationProperties.Name="{Binding VehicleCountText}" />
        </Border>
        <Border Grid.Column="1" Padding="14" BorderThickness="1" CornerRadius="8">
          <TextBlock Text="{Binding AlertCountText}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="MobileHomeAlertCount"
                     AutomationProperties.Name="{Binding AlertCountText}" />
        </Border>
      </Grid>

      <Border Padding="14" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding TopAlertHeading}"
                     FontSize="19"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="2" />
          <TextBlock Text="{Binding TopAlertText}"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="MobileHomeTopAlert"
                     AutomationProperties.Name="{Binding TopAlertText}" />
        </StackPanel>
      </Border>

      <Button Name="MobileHomePrimaryButton"
              Content="{Binding OpenVehiclesText}"
              Command="{Binding OpenVehiclesCommand}"
              MinHeight="48"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="MobileHomeOpenVehiclesButton"
              AutomationProperties.Name="{Binding OpenVehiclesName}" />
      <Button Content="{Binding OpenAlertsText}"
              Command="{Binding OpenAlertsCommand}"
              MinHeight="48"
              HorizontalAlignment="Stretch"
              AutomationProperties.AutomationId="MobileHomeOpenAlertsButton"
              AutomationProperties.Name="{Binding OpenAlertsName}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
