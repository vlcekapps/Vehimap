<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vehimap.Mobile.ViewModels"
             xmlns:views="using:Vehimap.Mobile.Views"
             x:Class="Vehimap.Mobile.Views.MobileMainView"
             x:DataType="vm:MobileMainViewModel"
             AutomationProperties.AutomationId="MobileMainView"
             AutomationProperties.Name="{Binding AppTitle}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="16,10"
            BorderThickness="0,0,0,1">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding AppTitle}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="MobileAppTitle"
                   AutomationProperties.Name="{Binding AppTitle}" />
        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="MobileLoadStatus"
                   AutomationProperties.Name="{Binding StatusText}"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          AutomationProperties.LandmarkType="Main"
          AutomationProperties.AccessibilityView="Control">
      <Panel IsVisible="{Binding IsHomeSelected}">
        <views:MobileHomeView DataContext="{Binding Home}" />
      </Panel>
      <Panel IsVisible="{Binding IsVehiclesSelected}">
        <views:MobileVehiclesView DataContext="{Binding Vehicles}" />
      </Panel>
      <Panel IsVisible="{Binding IsAlertsSelected}">
        <views:MobileAlertsView DataContext="{Binding Alerts}" />
      </Panel>
      <Panel IsVisible="{Binding IsMoreSelected}">
        <views:MobileMoreView DataContext="{Binding More}" />
      </Panel>
    </Grid>

    <Border Grid.Row="2"
            Padding="6"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,*,*,*"
            ColumnSpacing="4"
            AutomationProperties.AutomationId="MobilePrimaryNavigation"
            AutomationProperties.Name="{Binding NavigationName}"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.AccessibilityView="Control">
        <RadioButton Name="MobileHomeNavigationButton"
                     Grid.Column="0"
                     GroupName="MobilePrimaryNavigation"
                     Content="{Binding HomeNavigationText}"
                     Command="{Binding SelectHomeCommand}"
                     IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                     MinHeight="56"
                     HorizontalContentAlignment="Center"
                     AutomationProperties.AutomationId="MobileHomeNavigationButton"
                     AutomationProperties.Name="{Binding HomeNavigationText}" />
        <RadioButton Grid.Column="1"
                     GroupName="MobilePrimaryNavigation"
                     Content="{Binding VehiclesNavigationText}"
                     Command="{Binding SelectVehiclesCommand}"
                     IsChecked="{Binding IsVehiclesSelected, Mode=OneWay}"
                     MinHeight="56"
                     HorizontalContentAlignment="Center"
                     AutomationProperties.AutomationId="MobileVehiclesNavigationButton"
                     AutomationProperties.Name="{Binding VehiclesNavigationText}" />
        <RadioButton Grid.Column="2"
                     GroupName="MobilePrimaryNavigation"
                     Content="{Binding AlertsNavigationText}"
                     Command="{Binding SelectAlertsCommand}"
                     IsChecked="{Binding IsAlertsSelected, Mode=OneWay}"
                     MinHeight="56"
                     HorizontalContentAlignment="Center"
                     AutomationProperties.AutomationId="MobileAlertsNavigationButton"
                     AutomationProperties.Name="{Binding AlertsNavigationText}" />
        <RadioButton Grid.Column="3"
                     GroupName="MobilePrimaryNavigation"
                     Content="{Binding MoreNavigationText}"
                     Command="{Binding SelectMoreCommand}"
                     IsChecked="{Binding IsMoreSelected, Mode=OneWay}"
                     MinHeight="56"
                     HorizontalContentAlignment="Center"
                     AutomationProperties.AutomationId="MobileMoreNavigationButton"
                     AutomationProperties.Name="{Binding MoreNavigationText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
